DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full&sslnegotiation=direct&connect_timeout=15"
NEON_AUTH_URL="https://your-project.neonauth.c-2.us-east-2.aws.neon.build/dbname/auth"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
ADMIN_EMAILS="admin@example.com"
# After an admin signs up in Neon Auth, run: npm run db:verify-admins
# (marks ADMIN_EMAILS as emailVerified in neon_auth.user when mail isn't configured yet)
