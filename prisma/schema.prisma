generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BattleType {
  ONE_V_ONE
  FREE_FOR_ALL
}

enum TournamentStatus {
  OPEN
  SOON
  LIVE
  ENDED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum StartMode {
  MANUAL
  AUTO
}

enum TournamentPlayerRole {
  PLAYER
  HOST
  MOD
}

model User {
  id             String   @id
  email          String   @unique
  name           String
  displayName    String
  avatarUrl      String?
  bio            String?
  emailVerified  Boolean  @default(false)
  elo1v1         Int      @default(1200)
  eloTournament  Int      @default(1200)
  wins           Int      @default(0)
  matchCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSyncedAt   DateTime @default(now())

  hostedTournaments     Tournament[]           @relation("TournamentHost")
  moderatedTournaments  TournamentModerator[]
  tournamentPlayers     TournamentPlayer[]
}

model Tournament {
  id                String           @id @default(cuid())
  name              String
  type              BattleType
  scheduledAt       DateTime
  status            TournamentStatus
  playerCount       Int              @default(0)
  maxPlayers        Int
  durationMinutes   Int
  description       String
  visibility        Visibility
  startMode         StartMode
  passwordProtected Boolean          @default(false)
  passwordHash      String?
  hostId            String
  host              User             @relation("TournamentHost", fields: [hostId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  moderators        TournamentModerator[]
  players           TournamentPlayer[]
}

model TournamentModerator {
  tournamentId String
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
}

model TournamentPlayer {
  tournamentId String
  userId       String
  role         TournamentPlayerRole @default(PLAYER)
  joinedAt     DateTime             @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
}
